<?xml version="1.0" encoding="utf-8"?>
<!--
  DSH Android wrapper — AndroidManifest.xml (task-2, owner: android-shell).

  Компоненты:
  - MainActivity       — WebView на http://127.0.0.1:8081
  - DshService         — ForegroundService type dataSync, держит proot + dsh web
  - DshKeepAliveWorker — WorkManager, период 15 мин, перезапуск сервиса
  - BootReceiver       — BOOT_COMPLETED / LOCKED_BOOT_COMPLETED / MY_PACKAGE_REPLACED
  - ShareActivity      — приём ACTION_SEND/SEND_MULTIPLE (контракт files-bridge, task-4)
  - BatteryOptActivity — экран выхода из оптимизации батареи

  phone-apis (task-5): свой DroidBridge — файл bridge/DroidBridge.kt
  (СТОБ уже лежит там). НЕ переименовывай MainActivity/DshService.
  Точка подключения — MainActivity.attachBridge(), JS-имя "DroidBridge".
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Локальный WebView + опрос готовности; наружу не ходим, но флаг нужен
         для WebView и HttpURLConnection до 127.0.0.1. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Выживание в фоне -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Android 13+: показ ongoing-уведомления сервиса -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Вибрация — только через DroidBridge (task-5), shell сам не вибрирует -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:label="@string/app_name"
        android:theme="@style/Theme.DshWrapper"
        android:usesCleartextTraffic="true"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".BatteryOptActivity"
            android:exported="false" />

        <activity
            android:name=".DiagnosticsActivity"
            android:exported="false" />

        <!-- Tier 2 файлового моста (task-4): Share → /mfiles/api/fromphone -->
        <activity
            android:name=".ShareActivity"
            android:exported="true"
            android:theme="@style/Theme.DshWrapper">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- ForegroundService type dataSync: атрибут типа обязателен с API 29,
             на API 34+ система сверяет тип с разрешением
             FOREGROUND_SERVICE_DATA_SYNC. -->
        <service
            android:name=".DshService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
