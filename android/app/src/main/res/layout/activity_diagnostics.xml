<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Статус-блок -->
    <TextView
        android:id="@+id/diag_dsh_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/diag_dsh_label" />

    <TextView
        android:id="@+id/diag_zen_badge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/diag_zen_fail" />

    <!-- Вкладки логов -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Spinner
            android:id="@+id/diag_source"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <CheckBox
            android:id="@+id/diag_autoscroll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/diag_autoscroll" />
    </LinearLayout>

    <Spinner
        android:id="@+id/diag_home_file"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/diag_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/diag_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/diag_refresh"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/diag_refresh" />

        <Button
            android:id="@+id/diag_send"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/diag_send" />

        <Button
            android:id="@+id/diag_wipe"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/diag_wipe" />

        <Button
            android:id="@+id/diag_terminal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/diag_terminal" />
    </LinearLayout>

    <!-- ZEN_API_KEY -->
    <TextView
        android:id="@+id/diag_key_presence"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/diag_key_absent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/diag_key_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/diag_key_hint"
            android:inputType="textPassword"
            android:importantForAutofill="no" />

        <Button
            android:id="@+id/diag_key_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/diag_key_save" />

        <Button
            android:id="@+id/diag_key_clear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/diag_key_clear" />
    </LinearLayout>
</LinearLayout>
